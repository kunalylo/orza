# ─── Required in production ───────────────────────────────────────────
# MongoDB connection string. When unset (local dev only), data is stored in .data/orza-db.json
MONGODB_URI=
MONGODB_DB=orza

# Secret used to sign session cookies (any long random string, 32+ chars)
JWT_SECRET=

# ─── AI (OpenAI) ──────────────────────────────────────────────────────
# Without a key the app still works: meal text logging, chat, recipes and
# compensation plans fall back to ÖRZA's built-in Indian food database and
# rule-based coach. Photo scanning needs a key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# ─── Admin ────────────────────────────────────────────────────────────
# Comma-separated emails that get access to /dashboard/admin
ADMIN_EMAILS=

# Public site URL (used for metadata / sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3100
NEXT_PUBLIC_SUPPORT_EMAIL=

# ─── Notifications & reminders ────────────────────────────────────────
# Web Push (generate once: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@orza.app
# Secret for the reminder dispatcher (/api/cron/dispatch). Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# WhatsApp Business Cloud API (Meta). Leave empty to disable the WhatsApp channel.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template used outside the 24h session window (body params: {{1}} title, {{2}} details)
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
