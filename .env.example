# ─── Required in production ───────────────────────────────────────────
# MongoDB connection string. When unset (local dev only), data is stored in .data/orza-db.json
MONGODB_URI=
MONGODB_DB=orza

# Secret used to sign session cookies (any long random string, 32+ chars)
JWT_SECRET=

# ─── AI (OpenAI) ──────────────────────────────────────────────────────
# Without a key the app still works: meal text logging, chat, recipes and
# compensation plans fall back to ÖRZA's built-in Indian food database and
# rule-based coach. Photo scanning needs a key.
OPENAI_API_KEY=
# Text model (chat, meal text, recipes, rebalance). Reasoning models (o-series, gpt-5 family) work too.
OPENAI_MODEL=gpt-4o-mini
# Must accept image input (Snap & Know, prescription scans). Does not fall back to OPENAI_MODEL.
OPENAI_VISION_MODEL=gpt-4o-mini
# Reasoning models only: minimal | low | medium | high (default low, for quick replies)
OPENAI_REASONING_EFFORT=

# ─── Admin ────────────────────────────────────────────────────────────
# Admin access (/dashboard/admin) is granted per account, never by email list:
#   node scripts/make-admin.mjs person@example.com          (--revoke to remove, --list to see admins)

# Public site URL — canonical links, Open Graph, sitemap, calendar feed links and the alarm / WhatsApp
# links inside notifications. Set it to the real https:// origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
NEXT_PUBLIC_SUPPORT_EMAIL=

# Optional: how many reverse proxies in front of the app append to X-Forwarded-For (default 1).
# Rate limits key on the hop a client can't spoof. Ignored on Vercel.
TRUSTED_PROXY_HOPS=

# ─── Notifications & reminders ────────────────────────────────────────
# Web Push (generate once: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@orza.app
# Secret for the reminder dispatcher (/api/cron/dispatch). Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>";
# external schedulers (e.g. cron-job.org on Vercel Hobby, which has no per-minute crons) can call ?secret=<CRON_SECRET>.
CRON_SECRET=

# WhatsApp Business Cloud API (Meta). Leave empty to disable the WhatsApp channel.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template used outside the 24h session window (body params: {{1}} title, {{2}} details)
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
